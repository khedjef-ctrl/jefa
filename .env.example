# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# In development, defaults to http://localhost:3000
APP_URL="http://localhost:3000"

# STRIPE CONFIGURATION
# Stripe secret key for server-side Checkout Sessions & Customer Portal
STRIPE_SECRET_KEY="sk_test_..."
# Stripe publishable key for client-side
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Stripe webhook signing secret for verifying /api/stripe-webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# STRIPE PRICE IDs (Optional - defaults to recurring plan mapping)
STRIPE_PRICE_SOLO_MONTHLY="price_solo_monthly"
STRIPE_PRICE_SOLO_YEARLY="price_solo_yearly"
STRIPE_PRICE_AGENCY_MONTHLY="price_agency_monthly"
STRIPE_PRICE_AGENCY_YEARLY="price_agency_yearly"
STRIPE_PRICE_ENTERPRISE_MONTHLY="price_enterprise_monthly"
STRIPE_PRICE_ENTERPRISE_YEARLY="price_enterprise_yearly"

# ADMIN ACCESS ALLOWLIST (comma-separated emails allowed to access /admin)
ADMIN_EMAILS="khedjef@gmail.com,admin@policylens.ai"

# OPTIONAL: UPSTASH REDIS / KV FOR PERSISTENT DISTRIBUTED RATE LIMITING
# If not provided, PolicyLens uses robust in-memory sliding window rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
